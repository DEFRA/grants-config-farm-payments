                  "code": "APPLICATION_RECEIVED",
                  "processes": []
                },
                {
                  "code": "APPLICATION_REJECTED",
                  "processes": []
                },
                {
                  "code": "ON_HOLD",
                  "processes": []
                }
              ]
            },
            {
              "code": "AGREEMENT_GENERATING",
              "validFrom": [
                {
                  "code": "IN_REVIEW",
                  "processes": ["GENERATE_OFFER"]
                }
              ]
            },
            {
              "code": "ON_HOLD",
              "validFrom": [
                {
                  "code": "IN_REVIEW",
                  "processes": []
                }
              ]
            },
            {
              "code": "APPLICATION_REJECTED",
              "validFrom": [
                {
                  "code": "IN_REVIEW",
                  "processes": []
                }
              ]
            },
