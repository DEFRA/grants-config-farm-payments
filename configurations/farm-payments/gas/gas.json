                  "code": "POST_AGREEMENT_MONITORING:AGREEMENT_TERMINATION:TERMINATION_REQUESTED",
                  "processes": ["APPLY_AGREEMENT_TERMINATION"]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
